{
  "name": "jrlp-sealdice-plugin",
  "version": "1.3.0",
  "description": "今日老婆 - SealDice 骰子机器人插件 (GalGame/Anime 角色)",
  "main": "dist/jrlp.js",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "cross-env NODE_ENV=production node tools/build.js",
    "dev": "cross-env NODE_ENV=dev node tools/build.js",
    "typecheck": "tsc --noEmit",
    "check": "biome check src/",
    "format": "biome format --write src/",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
